{
  "name": "@cairn/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "pnpm routes:generate && tsc --noEmit && vite build",
    "build:release": "pnpm routes:generate && tsc --noEmit && vite build --mode release",
    "typecheck": "pnpm routes:generate && tsc --noEmit",
    "lint": "oxlint --config ../../.oxlintrc.json .",
    "lint:fix": "oxlint --config ../../.oxlintrc.json --fix .",
    "format": "oxfmt --config ../../.oxfmtrc.json --write .",
    "format:check": "oxfmt --config ../../.oxfmtrc.json --check .",
    "routes:generate": "tsr generate"
  },
  "dependencies": {
    "@cairn/client": "workspace:*",
    "@cairn/contracts": "workspace:*",
    "@cairn/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "1.170.44",
    "effect": "^4.0.4",
    "lucide-react": "^1.55.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tanstack/router-cli": "1.167.43",
    "@tanstack/router-plugin": "1.168.45",
    "@types/chrome": "^0.1.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
