{
  "name": "@cairn/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm routes:generate && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "pnpm routes:generate && tsc --noEmit && tsc --project tsconfig.node.json --noEmit",
    "lint": "oxlint --config ../../.oxlintrc.json .",
    "lint:fix": "oxlint --config ../../.oxlintrc.json --fix .",
    "format": "oxfmt --config ../../.oxfmtrc.json --write .",
    "format:check": "oxfmt --config ../../.oxfmtrc.json --check .",
    "routes:generate": "tsr generate"
  },
  "dependencies": {
    "@cairn/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "1.170.44",
    "@tauri-apps/api": "^2",
    "effect": "^4.0.4",
    "lucide-react": "^1.55.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tanstack/router-cli": "1.167.43",
    "@tanstack/router-plugin": "1.168.45",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
