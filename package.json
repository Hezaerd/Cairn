{
  "name": "cairn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:desktop": "pnpm --filter @cairn/desktop tauri dev",
    "dev:extension": "pnpm --filter @cairn/extension dev",
    "build": "pnpm -r build",
    "build:desktop": "pnpm --filter @cairn/desktop tauri build",
    "build:extension": "pnpm --filter @cairn/extension build",
    "typecheck": "pnpm -r typecheck",
    "check:rust": "cargo check --workspace",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm check:rust",
    "build:host": "cargo build -p cairn-native-host",
    "test:ts": "tsx --test tests/*.test.ts",
    "test:rust": "cargo test --workspace",
    "test": "pnpm test:ts && pnpm test:rust",
    "test:helium": "tsx tests/helium.e2e.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:vault": "tsx tests/vault.e2e.ts",
    "test:autofill": "tsx tests/autofill.e2e.ts",
    "icons": "tsx scripts/icons.ts"
  },
  "devDependencies": {
    "@cairn/client": "workspace:*",
    "@cairn/contracts": "workspace:*",
    "@oxlint/plugins": "1.88.0",
    "@types/node": "^24.0.0",
    "effect": "^4.0.4",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "playwright": "^1.64.0",
    "tsx": "^4.20.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.6.0"
}
