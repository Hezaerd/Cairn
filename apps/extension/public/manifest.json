{
  "manifest_version": 3,
  "name": "Cairn",
  "version": "0.1.0",
  "description": "Cairn browser companion",
  "action": {
    "default_title": "Cairn",
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["nativeMessaging"]
}
