  "build": {
    "beforeBuildCommand": "pnpm build && pnpm -w build:connector"
  },
  "bundle": {
    "resources": {
      "../../../target/release/cairn-native-host.exe": "cairn-native-host.exe",
      "../../../target/connector/cairn-native-host.json": "cairn-native-host.json",
